[Unit]
Description=BliKVM approved read-only media delegate
Requires=blikvm-gadget.service
After=blikvm-gadget.service
Before=kvmd.service

[Service]
Type=exec
ExecStart=/usr/lib/kvmd-msd/media-helper
Restart=on-failure
RestartSec=2
RuntimeDirectory=kvmd-msd
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN
DevicePolicy=closed
ReadOnlyPaths=/sys/kernel/config
ReadWritePaths=/sys/kernel/config/usb_gadget/blikvm_m5/functions/mass_storage.g4/lun.0/file
ReadWritePaths=/sys/kernel/config/usb_gadget/blikvm_m5/functions/mass_storage.g4/lun.0/forced_eject

[Install]
WantedBy=multi-user.target
