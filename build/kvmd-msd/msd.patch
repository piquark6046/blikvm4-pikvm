+++ b/kvmd/plugins/msd/otg/static_storage.py
@@ -0,0 +1,65 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Build-time catalog for the upstream OTG state machine; no remount/write paths."""
+import json
+from pathlib import Path
+from .storage import _make_image
+from .. import MsdOperationError, MsdUnknownImageError
+
+
+class StaticStorage:
+    def __init__(self, manifest: str, root: str) -> None:
+        self.__manifest = Path(manifest)
+        self.__root = Path(root)
+        self.__images = {}
+
+    async def is_probably_enabled(self) -> bool:
+        return self.__manifest.is_file() and self.__root.is_dir()
+
+    async def reload(self):
+        yield str(self.__root)
+        data = json.loads(self.__manifest.read_text())
+        images = {}
+        for name, expected in data.items():
+            if Path(name).name != name or name.startswith('.'):
+                raise MsdOperationError('Invalid catalog name')
+            path = self.__root / name
+            if path.is_symlink() or not path.is_file() or path.stat().st_size != expected['size']:
+                raise MsdOperationError('Invalid catalog image')
+            image = await _make_image(name, str(path), True, True)
+            if image.removable or image.writable:
+                raise MsdOperationError('Catalog must be read-only')
+            images[name] = image
+        self.__images = images
+
+    def get_state(self):
+        return {'images': {name: {'size': im.size, 'mod_ts': im.mod_ts, 'complete': True,
+                                 'removable': False, 'writable': False}
+                           for name, im in self.__images.items()},
+                'parts': {'': {'size': sum(im.size for im in self.__images.values()),
+                               'free': 0, 'writable': False}}}
+
+    async def get_image_by_name(self, name):
+        if name not in self.__images:
+            raise MsdUnknownImageError()
+        return self.__images[name]
+
+    async def get_image_by_path(self, path):
+        for image in self.__images.values():
+            if image.path == path:
+                return image
+        raise MsdUnknownImageError()
+
+    async def remount_ro(self):
+        pass
+
+    async def remount_probe(self):
+        pass
+
+    async def remount_rw(self, image):
+        raise MsdOperationError('Read-only catalog')
+
+    async def make_image(self, name):
+        raise MsdOperationError('Uploads disabled')
+
+    async def remove_image(self, image, fatal):
+        raise MsdOperationError('Deletion disabled')
