# Linux 7.x first-slice config. Start from allnoconfig and enable only the
# facilities required to boot an H616, log on UART0, unpack the Alpine
# initramfs, run an interactive BusyBox shell, and read the existing ext4 SD
# partitions through MMC0.
#
# The equivalent options were verified as built-in in the known-good vendor
# 5.19.4 Image with scripts/extract-ikconfig:
# ARCH_SUNXI, BLK_DEV_INITRD, RD_GZIP, BINFMT_ELF, BINFMT_SCRIPT, DEVTMPFS,
# DEVTMPFS_MOUNT, SERIAL_8250, SERIAL_8250_CONSOLE, SERIAL_8250_DW,
# SERIAL_OF_PLATFORM, PINCTRL_SUN50I_H616, DMA_SUN6I,
# SUN50I_H616_CCU, TMPFS, PRINTK_TIME, MAGIC_SYSRQ_SERIAL, BLOCK, MMC,
# MMC_BLOCK, MMC_SUNXI, REGULATOR, REGULATOR_FIXED_VOLTAGE, and EXT4_FS.

CONFIG_ARCH_SUNXI=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y

CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

CONFIG_COMMON_CLK=y
CONFIG_SUNXI_CCU=y
CONFIG_SUN50I_H616_CCU=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SUN50I_H616=y
CONFIG_PINCTRL_SUN50I_H616_R=y
CONFIG_GPIOLIB=y
CONFIG_RESET_CONTROLLER=y
CONFIG_DMADEVICES=y
CONFIG_DMA_ENGINE=y
CONFIG_DMA_SUN6I=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_UNIX=y

CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# CONFIG_EFI_PARTITION is not set
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_EXT4_FS=y

CONFIG_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LOCALVERSION="-blikvm-v4-mmc"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set
# CONFIG_NETDEVICES is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
