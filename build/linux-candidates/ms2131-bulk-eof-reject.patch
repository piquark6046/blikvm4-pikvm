+/*
+ * The MS2131 can append its header-only EOF transfer to a JPEG payload
+ * ending on a 512-byte boundary. Reject this malformed frame; do not trim
+ * data that merely resembles a header. Normal EOF-only transfers, other
+ * formats and devices retain the ordinary decoder path.
+ */
+static bool uvc_video_ms2131_bad_eof(const u8 *data, unsigned int len,
+				  unsigned int requested,
+				  unsigned int maximum,
+				  unsigned int maxpacket)
+{
+	const u8 *eof;
+
+	if (maxpacket != 512 || len < 526 || len >= requested ||
+	    len >= maximum || (len - 12) % maxpacket)
+		return false;
+	if (data[0] != 12 || (data[1] != 0x8c && data[1] != 0x8d))
+		return false;
+
+	eof = data + len - 12;
+	return eof[-2] == 0xff && eof[-1] == JPEG_MARKER_EOI &&
+	       eof[0] == 12 && eof[1] == (data[1] | UVC_STREAM_EOF) &&
+	       !memcmp(eof + 2, data + 2, 4) &&
+	       !(eof[11] & 0xf8);
+}
+
 static void uvc_video_decode_bulk(struct uvc_urb *uvc_urb,
 			struct uvc_buffer *buf, struct uvc_buffer *meta_buf)
 {
