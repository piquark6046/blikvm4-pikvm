# Additive M7 exception: systemd documented requirements absent from frozen M5.
CONFIG_MULTIUSER=y
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
# SSH PTYs, systemd service sandboxing and normal glibc process facilities.
CONFIG_UNIX98_PTYS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SYSVIPC=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_ADVISE_SYSCALLS=y
# First Ubuntu HIL boot: journald/udev require /proc/sys; sysusers/login
# require flock. Enable the automount filesystem requested by PID 1 too.
CONFIG_PROC_SYSCTL=y
CONFIG_FILE_LOCKING=y
CONFIG_AUTOFS_FS=y
CONFIG_LOCALVERSION="-blikvm-v4-m7"
