def read_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except (FileNotFoundError, PermissionError, OSError):
        return None


def read_int(path: Path, default: int | None = None) -> int | None:
    value = read_text(path)
    if value is None:
        return default
    try:
        return int(value)
    except ValueError:
        return default


def dev_display_path(path: Path, dev_root: Path) -> str:
    try:
        relative = path.relative_to(dev_root)
    except ValueError:
        return str(path)
    return "/dev/" + relative.as_posix()


def tty_paths(sys_root: Path, dev_root: Path) -> dict[str, dict[str, Any]]:
    result: dict[str, dict[str, Any]] = {}
    class_root = sys_root / "class" / "tty"
    try:
        entries = sorted(class_root.iterdir(), key=lambda item: item.name)
    except (FileNotFoundError, PermissionError, OSError):
        entries = []

    for entry in entries:
        if not (entry.name.startswith("ttyUSB") or entry.name.startswith("ttyACM")):
            continue
        try:
            resolved = str(entry.resolve(strict=False))
        except OSError:
            resolved = str(entry)
        result[entry.name] = {
            "name": entry.name,
            "device_path": dev_display_path(dev_root / entry.name, dev_root),
            "sysfs_path": resolved,
            "stable_paths": [],
        }

    by_id = dev_root / "serial" / "by-id"
    try:
        stable_entries = sorted(by_id.iterdir(), key=lambda item: item.name)
    except (FileNotFoundError, PermissionError, OSError):
        stable_entries = []

    for entry in stable_entries:
        try:
            target_name = entry.resolve(strict=False).name
        except OSError:
            continue
        if target_name in result:
            result[target_name]["stable_paths"].append(
                dev_display_path(entry, dev_root)
            )

    return result


def usb_devices(sys_root: Path, ttys: dict[str, dict[str, Any]]) -> list[dict[str, Any]]:
    devices_root = sys_root / "bus" / "usb" / "devices"
    try:
        entries = sorted(devices_root.iterdir(), key=lambda item: item.name)
    except (FileNotFoundError, PermissionError, OSError):
        return []

    devices: list[dict[str, Any]] = []
    for entry in entries:
        vendor = read_text(entry / "idVendor")
        product_id = read_text(entry / "idProduct")
        if vendor is None or product_id is None:
            continue

        vendor = vendor.lower()
        product_id = product_id.lower()
        sys_name = entry.name
        matched_ttys: list[str] = []
        for tty_name, tty in ttys.items():
            resolved = tty["sysfs_path"]
            # Root hubs are named usbN and appear in every child device path.
            # Only physical device nodes (for example 1-2) can own a tty.
            if "-" in sys_name and (
                f"/{sys_name}/" in resolved or f"/{sys_name}:" in resolved
            ):
                matched_ttys.append(tty_name)

        device: dict[str, Any] = {
            "sysfs_name": sys_name,
            "usb_id": f"{vendor}:{product_id}",
            "role": USB_ROLES.get((vendor, product_id), "other"),
            "manufacturer": read_text(entry / "manufacturer"),
            "product": read_text(entry / "product"),
            "serial": read_text(entry / "serial"),
            "speed_mbps": read_int(entry / "speed"),
            "bus_number": read_int(entry / "busnum"),
            "device_number": read_int(entry / "devnum"),
            "tty_devices": sorted(matched_ttys),
        }
        devices.append(device)
    return devices


def serial_devices(
    ttys: dict[str, dict[str, Any]], usb: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    roles_by_tty: dict[str, str] = {}
    usb_ids_by_tty: dict[str, str] = {}
    for device in usb:
        for tty_name in device["tty_devices"]:
            roles_by_tty[tty_name] = device["role"]
            usb_ids_by_tty[tty_name] = device["usb_id"]

    serial: list[dict[str, Any]] = []
    for tty_name in sorted(ttys):
        tty = ttys[tty_name]
        serial.append(
            {
                "name": tty_name,
                "device_path": tty["device_path"],
                "stable_paths": tty["stable_paths"],
                "usb_id": usb_ids_by_tty.get(tty_name),
                "role": roles_by_tty.get(tty_name, "other"),
            }
        )
    return serial


def network_interfaces(sys_root: Path) -> list[dict[str, Any]]:
    class_root = sys_root / "class" / "net"
    try:
        entries = sorted(class_root.iterdir(), key=lambda item: item.name)
    except (FileNotFoundError, PermissionError, OSError):
        return []

    interfaces: list[dict[str, Any]] = []
    for entry in entries:
        interface_type = read_int(entry / "type")
        if entry.name == "lo":
            kind = "loopback"
        elif (entry / "wireless").exists() or entry.name.startswith("wl"):
            kind = "wireless"
        elif interface_type == 1 and (entry / "device").exists():
            kind = "ethernet"
        else:
            kind = "virtual_or_other"

        interfaces.append(
            {
                "name": entry.name,
                "kind": kind,
                "address": read_text(entry / "address"),
                "operstate": read_text(entry / "operstate"),
                "carrier": read_int(entry / "carrier"),
            }
        )
    return interfaces


def block_devices(sys_root: Path) -> list[dict[str, Any]]:
    class_root = sys_root / "class" / "block"
    try:
        entries = sorted(class_root.iterdir(), key=lambda item: item.name)
    except (FileNotFoundError, PermissionError, OSError):
        return []

    devices: list[dict[str, Any]] = []
    for entry in entries:
        if (entry / "partition").exists():
            continue
        sectors = read_int(entry / "size")
        serial = read_text(entry / "device" / "serial")
        devices.append(
            {
                "name": entry.name,
                "size_bytes": sectors * 512 if sectors is not None else None,
                "removable": read_int(entry / "removable"),
                "model": read_text(entry / "device" / "model"),
                "serial": serial,
                "protected": serial == "0x979a962d",
            }
        )
    return devices


def discover_tools() -> dict[str, str | None]:
    return {name: shutil.which(name) for name in DISCOVERED_TOOLS}


def check_report(
    usb: list[dict[str, Any]],
    serial: list[dict[str, Any]],
    interfaces: list[dict[str, Any]],
    tools: dict[str, str | None],
) -> tuple[dict[str, Any], list[str], list[str]]:
    blockers: list[str] = []
    warnings: list[str] = []

    uart_usb = [device for device in usb if device["role"] == "blikvm_uart"]
    if len(uart_usb) == 1:
        uart_status = "pass"
    elif not uart_usb:
        uart_status = "missing"
        blockers.append("BliKVM UART USB device 1a86:7523 was not found")
    else:
        uart_status = "ambiguous"
        blockers.append("More than one BliKVM UART USB device 1a86:7523 was found")

    uart_serial = [device for device in serial if device["role"] == "blikvm_uart"]
    stable_paths = sorted(
        path for device in uart_serial for path in device["stable_paths"]
    )
    if len(stable_paths) == 1:
        stable_status = "pass"
    elif not stable_paths:
        stable_status = "missing"
        blockers.append("No stable /dev/serial/by-id path was found for the BliKVM UART")
    else:
        stable_status = "ambiguous"
        blockers.append("More than one stable path was found for the BliKVM UART")

    ethernet = [item for item in interfaces if item["kind"] == "ethernet"]
    ethernet_with_carrier = [item for item in ethernet if item["carrier"] == 1]
    if ethernet_with_carrier:
        ethernet_status = "pass"
    elif ethernet:
        ethernet_status = "no_carrier"
        blockers.append("No physical Ethernet interface currently has carrier")
    else:
        ethernet_status = "missing"
        blockers.append("No physical Ethernet interface was found")

    missing_build_tools = [name for name in REQUIRED_BUILD_TOOLS if not tools[name]]
    container_runtime = tools["podman"] or tools["docker"]
    if missing_build_tools and not container_runtime:
        build_status = "missing"
        blockers.append(
            "Kernel build prerequisites are missing and no container runtime is available: "
            + ", ".join(missing_build_tools)
        )
    elif missing_build_tools:
        build_status = "container_available"
        warnings.append(
            "Native build prerequisites are missing; use the detected container runtime: "
            + ", ".join(missing_build_tools)
        )
    else:
        build_status = "pass"

    fel_count = sum(device["role"] == "allwinner_fel" for device in usb)
    gadget_count = sum(device["role"] == "blikvm_usb_gadget" for device in usb)

    checks = {
        "blikvm_uart": {"status": uart_status, "count": len(uart_usb)},
        "stable_uart_path": {"status": stable_status, "paths": stable_paths},
        "lab_ethernet_carrier": {
            "status": ethernet_status,
            "interfaces": [item["name"] for item in ethernet_with_carrier],
        },
        "build_toolchain": {
            "status": build_status,
            "missing_native_tools": missing_build_tools,
            "container_runtime": container_runtime,
        },
        "optional_usb_modes": {
            "fel_devices": fel_count,
            "gadget_devices": gadget_count,
        },
    }
    return checks, blockers, warnings


def detect(sys_root: Path, dev_root: Path) -> dict[str, Any]:
    ttys = tty_paths(sys_root, dev_root)
    usb = usb_devices(sys_root, ttys)
    serial = serial_devices(ttys, usb)
    interfaces = network_interfaces(sys_root)
    blocks = block_devices(sys_root)
    tools = discover_tools()
    checks, blockers, warnings = check_report(usb, serial, interfaces, tools)

    return {
        "schema_version": SCHEMA_VERSION,
        "command": "detect",
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "result": "ok",
        "readiness": "blocked" if blockers else "ready",
        "host": {
            "platform": platform.system(),
            "kernel": platform.release(),
            "machine": platform.machine(),
        },
        "roots": {"sys": str(sys_root), "dev": str(dev_root)},
        "usb_devices": usb,
        "serial_devices": serial,
        "network_interfaces": interfaces,
        "block_devices": blocks,
        "tools": tools,
        "checks": checks,
        "blockers": blockers,
        "warnings": warnings,
    }


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def clean_console(data: bytes | str) -> str:
    if isinstance(data, bytes):
        text = data.decode("utf-8", errors="replace")
    else:
        text = data
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    return ANSI_ESCAPE.sub("", text)


def write_json(path: Path, value: dict[str, Any]) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    temporary.replace(path)


def git_revision() -> str:
    try:
        process = subprocess.run(
            ["git", "rev-parse", "--short=12", "HEAD"],
            cwd=REPOSITORY_ROOT,
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return "unknown"
    return process.stdout.strip() or "unknown"


class RunRecorder:
    def __init__(self, command: str, out_root: Path) -> None:
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        suffix = f"{time.time_ns() % 1_000_000:06d}"
        self.run_id = f"{stamp}-{git_revision()[:7]}-{suffix}"
        self.path = out_root / self.run_id
        self.path.mkdir(parents=True, exist_ok=False)
        self.metadata: dict[str, Any] = {
            "schema_version": SCHEMA_VERSION,
            "run_id": self.run_id,
            "command": command,
            "started_at": utc_now(),
            "repository_revision": git_revision(),
            "host": {
                "platform": platform.system(),
                "kernel": platform.release(),
                "machine": platform.machine(),
            },
            "safety": {"persistent_uboot_environment_written": False},
        }
        write_json(self.path / "metadata.json", self.metadata)

    def log_uart(self, direction: str, data: bytes) -> None:
        if not data:
            return
        stamp = utc_now()
        rendered = data.decode("utf-8", errors="backslashreplace")
        with (self.path / "uart.log").open("a", encoding="utf-8") as stream:
            stream.write(f"[{stamp}] {direction} {rendered}")
            if not rendered.endswith("\n"):
                stream.write("\n")
        if direction == "RX":
            with (self.path / "uart.raw").open("ab") as stream:
                stream.write(data)

    def log_uboot(self, heading: str, text: str) -> None:
        with (self.path / "uboot.log").open("a", encoding="utf-8") as stream:
            stream.write(f"\n## {heading}\n{text.rstrip()}\n")

    def save_text(self, name: str, text: str) -> None:
        (self.path / name).write_text(text, encoding="utf-8")

    def finish(self, report: dict[str, Any]) -> dict[str, Any]:
        report.setdefault("schema_version", SCHEMA_VERSION)
        report.setdefault("run_id", self.run_id)
        report.setdefault("run_directory", str(self.path))
        report.setdefault("finished_at", utc_now())
        self.metadata["finished_at"] = report["finished_at"]
        self.metadata["result"] = report.get("result", "error")
        self.metadata["stage"] = report.get("stage")
        write_json(self.path / "metadata.json", self.metadata)
        write_json(self.path / "test-results.json", report)
        sudo_uid = os.environ.get("SUDO_UID")
        sudo_gid = os.environ.get("SUDO_GID")
        if sudo_uid and sudo_gid:
            uid, gid = int(sudo_uid), int(sudo_gid)
            for path in (self.path, *self.path.rglob("*")):
                with contextlib.suppress(OSError):
                    os.chown(path, uid, gid)
        return report


def resolve_uart_device(sys_root: Path, dev_root: Path, override: str | None) -> Path:
    if override:
        path = Path(override)
        if not path.exists():
            raise RuntimeError(f"UART device does not exist: {path}")
        return path

    report = detect(sys_root, dev_root)
    matches = [
        item
        for item in report["serial_devices"]
        if item["role"] == "blikvm_uart" and item["usb_id"] == UART_USB_ID
    ]
    if len(matches) != 1:
        raise RuntimeError(
            f"expected exactly one BliKVM UART {UART_USB_ID}, found {len(matches)}"
        )
    stable_paths = matches[0]["stable_paths"]
    if len(stable_paths) != 1:
        raise RuntimeError(
            "BliKVM UART must resolve to exactly one /dev/serial/by-id path"
        )
    path = Path(stable_paths[0])
    if dev_root != Path("/dev"):
        path = dev_root / path.relative_to("/dev")
    return path


class SerialConsole:
    def __init__(self, path: Path, recorder: RunRecorder) -> None:
        self.path = path
        self.recorder = recorder
        self.fd: int | None = None
        self.original_attributes: list[Any] | None = None

    def __enter__(self) -> "SerialConsole":
        try:
            self.fd = os.open(self.path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        except PermissionError as error:
            raise RuntimeError(
                f"permission denied opening {self.path}; run labctl via sudo or grant "
                "the user dialout access"
            ) from error
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            os.close(self.fd)
            self.fd = None
            raise RuntimeError(f"UART is already locked: {self.path}") from error

        self.original_attributes = termios.tcgetattr(self.fd)
        tty.setraw(self.fd, when=termios.TCSANOW)
        attributes = termios.tcgetattr(self.fd)
        attributes[2] |= termios.CLOCAL | termios.CREAD
        attributes[2] &= ~termios.CSIZE
        attributes[2] |= termios.CS8
        attributes[2] &= ~(termios.PARENB | termios.CSTOPB)
        if hasattr(termios, "CRTSCTS"):
            attributes[2] &= ~termios.CRTSCTS
        attributes[4] = termios.B115200
        attributes[5] = termios.B115200
        termios.tcsetattr(self.fd, termios.TCSANOW, attributes)
        termios.tcflush(self.fd, termios.TCIFLUSH)
        return self

    def __exit__(self, *_error: object) -> None:
        if self.fd is None:
            return
        if self.original_attributes is not None:
            with contextlib.suppress(termios.error):
                termios.tcsetattr(self.fd, termios.TCSANOW, self.original_attributes)
        with contextlib.suppress(OSError):
            fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)
        self.fd = None

    def write(self, data: bytes, *, log: bool = True) -> None:
        if self.fd is None:
            raise RuntimeError("UART is not open")
        view = memoryview(data)
        while view:
            _, writable, _ = select.select([], [self.fd], [], 2.0)
            if not writable:
                raise TimeoutError("timed out writing to UART")
            count = os.write(self.fd, view)
            view = view[count:]
        if log:
            self.recorder.log_uart("TX", data)
        else:
            self.recorder.log_uart("TX", b"<redacted>\r")

    def read_chunk(self, timeout: float = 0.25) -> bytes:
        if self.fd is None:
            raise RuntimeError("UART is not open")
        readable, _, _ = select.select([self.fd], [], [], timeout)
        if not readable:
            return b""
        try:
            data = os.read(self.fd, 65536)
        except BlockingIOError:
            return b""
        self.recorder.log_uart("RX", data)
        return data

    def read_for(self, seconds: float) -> bytes:
        deadline = time.monotonic() + seconds
        chunks: list[bytes] = []
        while time.monotonic() < deadline:
            chunk = self.read_chunk(min(0.25, max(0.0, deadline - time.monotonic())))
            if chunk:
                chunks.append(chunk)
        return b"".join(chunks)

    def wait_for(
        self, patterns: tuple[re.Pattern[str], ...], timeout: float
    ) -> tuple[int, str]:
        deadline = time.monotonic() + timeout
        data = bytearray()
        while time.monotonic() < deadline:
            text = clean_console(bytes(data))
            matched: int | None = None
            for index, pattern in enumerate(patterns):
                if pattern.search(text):
                    matched = index
                    break
            if matched is not None:
                # A prompt-like byte sequence can occur at the end of a chunk
                # in bulk output. Require a brief quiet interval.
                extra = self.read_chunk(0.08)
                if not extra:
                    return matched, text
                data.extend(extra)
                continue
            chunk = self.read_chunk(min(0.25, max(0.0, deadline - time.monotonic())))
            if chunk:
                data.extend(chunk)
        raise TimeoutError(
            f"timed out after {timeout:.1f}s waiting for console pattern; "
            f"last output: {clean_console(bytes(data))[-500:]!r}"
        )


class UBootSession:
    def __init__(
        self,
        console: SerialConsole,
        recorder: RunRecorder,
        boot_timeout: float = 90.0,
        login_user: str = "blikvm",
        password_file: Path | None = None,
    ) -> None:
        self.console = console
        self.recorder = recorder
        self.boot_timeout = boot_timeout
        self.login_user = login_user
        self.password_file = password_file

    def acquire_prompt(self, allow_reboot: bool = True) -> str:
        # Ctrl-C elicits the current prompt without repeating U-Boot's previous
        # command (an empty Enter is repeat-command in this build).
        self.console.write(b"\x03")
        try:
            state, text = self.console.wait_for(
                (UBOOT_PROMPT, LINUX_PROMPT, LOGIN_PROMPT, PASSWORD_PROMPT), 3.0
            )
        except TimeoutError:
            self.console.write(b"\r")
            state, text = self.console.wait_for(
                (UBOOT_PROMPT, LINUX_PROMPT, LOGIN_PROMPT, PASSWORD_PROMPT), 3.0
            )
        if state == 0:
            self.recorder.log_uboot("prompt acquired", text)
            return text
        if not allow_reboot:
            raise RuntimeError("target is not at a U-Boot prompt")
        if state == 3:
            # A password prompt observed immediately after opening the UART may
            # belong to a username assembled from line-setup noise. Do not
            # disclose the credential into that unknown authentication flow.
            # Submit an empty password and restart from a fresh login prompt.
            self.console.write(b"\r")
            self.console.wait_for((LOGIN_PROMPT,), 10.0)
            state = 2
        if state == 2:
            if self.password_file is None:
                raise RuntimeError(
                    "target is at a Linux authentication prompt; provide --target-password-file "
                    "or log in/reboot the board while labctl is waiting"
                )
            try:
                password = self.password_file.read_text(encoding="utf-8").splitlines()[0]
            except (OSError, IndexError) as error:
                raise RuntimeError("could not read a password from the credential file") from error
            if not password:
                raise RuntimeError("target credential file contains an empty password")
            self.console.write(self.login_user.encode("utf-8") + b"\r")
            self.console.wait_for((PASSWORD_PROMPT,), 10.0)
            self.console.write(password.encode("utf-8") + b"\r", log=False)
            _, text = self.console.wait_for((LINUX_PROMPT,), 20.0)
            password = ""

        # The vendor image permits reboot through logind; the bring-up
        # initramfs has only BusyBox. This shell expression supports both.
        self.console.write(
            b"if command -v systemctl >/dev/null 2>&1; then systemctl reboot; "
            b"else reboot -f; fi\r"
        )
        deadline = time.monotonic() + self.boot_timeout
        data = bytearray()
        interrupted = False
        saw_uboot = False
        while time.monotonic() < deadline:
            chunk = self.console.read_chunk(0.2)
            if not chunk:
                continue
            data.extend(chunk)
            text = clean_console(bytes(data))
            if "U-Boot " in text:
                saw_uboot = True
            if not interrupted and (
                "Autoboot in" in text or "Hit any key to stop autoboot" in text
            ):
                self.console.write(b" ")
                interrupted = True
            if interrupted and UBOOT_PROMPT.search(text):
                self.recorder.log_uboot("boot capture and autoboot interrupt", text)
                return text
            if "Authentication is required" in text or "Access denied" in text:
                raise RuntimeError("Linux refused the unprivileged reboot request")
        if saw_uboot and not interrupted:
            reason = "U-Boot started but the autoboot countdown was not interrupted"
        else:
            reason = "did not reach a U-Boot prompt"
        raise TimeoutError(f"{reason} within {self.boot_timeout:.1f}s")

    def execute(self, command: str, timeout: float = 15.0) -> str:
        command = command.strip()
        if not command or "\n" in command or "\r" in command:
            raise ValueError("U-Boot command must be one non-empty line")
        for pattern in FORBIDDEN_UBOOT_PATTERNS:
            if pattern.search(command):
                raise ValueError(f"refusing persistent/destructive U-Boot command: {command}")
        self.console.write(command.encode("utf-8") + b"\r")
        _, text = self.console.wait_for((UBOOT_PROMPT,), timeout)
        self.recorder.log_uboot(command, text)
        return text


def parse_environment(text: str) -> dict[str, str]:
    environment: dict[str, str] = {}
    for line in clean_console(text).splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            environment[key] = value
    return environment


def required_load_addresses(session: UBootSession) -> dict[str, str]:
    text = session.execute("printenv kernel_addr_r fdt_addr_r ramdisk_addr_r", 10.0)
    environment = parse_environment(text)
    required = ("kernel_addr_r", "fdt_addr_r", "ramdisk_addr_r")
    missing = [name for name in required if name not in environment]
    if missing:
        raise RuntimeError("missing U-Boot load addresses: " + ", ".join(missing))
    for name in required:
        if not re.fullmatch(r"0x[0-9A-Fa-f]+", environment[name]):
            raise RuntimeError(f"invalid U-Boot address {name}={environment[name]!r}")
    return {name: environment[name] for name in required}


def memory_value(text: str, bits: int) -> int:
    digits = 16 if bits == 64 else 8
    match = re.search(rf"(?m)^[0-9a-fA-F]+:\s+([0-9a-fA-F]{{{digits}}})", text)
    if not match:
        raise RuntimeError(f"could not parse {bits}-bit U-Boot memory value")
    return int(match.group(1), 16)


def apply_vendor_phy_workaround(session: UBootSession) -> dict[str, Any]:
    """Correct the known vendor control-DT PHY address in RAM only.

    The shipped U-Boot control DT points EMAC1 at MDIO address 0x10, while
    both the Linux DT and live Clause-22 ID registers locate the PHY at 0.
    All version, DT, object-layout, pointer-range, and current-value guards
    must pass before the single phy_device.addr word is changed.
    """

    version = session.execute("version", 10.0)
    expected_version = "U-Boot 2021.10-armbian (Feb 20 2023 - 09:48:57 +0800)"
    if expected_version not in version:
        raise RuntimeError("refusing PHY workaround on an unknown U-Boot build")

    board = session.execute("bdinfo", 10.0)
    if (
        "-> start    = 0x0000000040000000" not in board
        or "-> size     = 0x0000000040000000" not in board
    ):
        raise RuntimeError("refusing PHY workaround outside the verified 1 GiB DRAM map")

    control_fdt = session.execute(
        "fdt addr ${fdtcontroladdr}; fdt print /soc/ethernet@5030000", 10.0
    )
    if 'ethernet-phy@16' not in control_fdt or "reg = <0x00000010>" not in control_fdt:
        raise RuntimeError("vendor U-Boot control-DT PHY mismatch was not found")

    phy_id = session.execute("mdio read ethernet@5030000 0 2-3", 10.0)
    if "2 - 0x44" not in phy_id or "3 - 0x1400" not in phy_id:
        raise RuntimeError("real PHY ID at MDIO address 0 is not the verified device")

    devices = session.execute("dm uclass", 10.0)
    match = re.search(r"ethernet@5030000\s+@\s+([0-9a-fA-F]+)", devices)
    if not match:
        raise RuntimeError("could not locate the live EMAC udevice")
    udevice = int(match.group(1), 16)
    if not 0x40000000 <= udevice < 0x80000000:
        raise RuntimeError("EMAC udevice pointer is outside verified DRAM")

    private_output = session.execute(f"md.q {udevice + 0x38:x} 1", 10.0)
    private = memory_value(private_output, 64)
    if not 0x40000000 <= private < 0x80000000:
        raise RuntimeError("EMAC private pointer is outside verified DRAM")

    # These offsets are guarded by the exact vendor build above and verified
    # against its live interface=RMII/phyaddr words before any write.
    private_header = session.execute(f"md.l {private + 0x21000:x} 2", 10.0)
    values = re.search(
        r"(?m)^[0-9a-fA-F]+:\s+([0-9a-fA-F]{8})\s+([0-9a-fA-F]{8})",
        private_header,
    )
    if not values or int(values.group(1), 16) != 6:
        raise RuntimeError("EMAC private layout guard failed")
    configured_phyaddr = int(values.group(2), 16)
    if configured_phyaddr != 0x10:
        raise RuntimeError("EMAC private PHY address is not the expected bad value 0x10")

    phydev_output = session.execute(f"md.q {private + 0x21040:x} 1", 10.0)
    phydev = memory_value(phydev_output, 64)
    if not 0x40000000 <= phydev < 0x80000000:
        raise RuntimeError("PHY object pointer is outside verified DRAM")
    address_field = phydev + 0x4C
    current_output = session.execute(f"md.l {address_field:x} 1", 10.0)
    current = memory_value(current_output, 32)
    if current == 0:
        return {
            "applied": False,
            "reason": "already_corrected",
            "control_dt_phy_address": 0x10,
            "runtime_phy_address": 0,
        }
    if current != 0x10:
        raise RuntimeError(
            f"PHY object layout guard found unexpected address 0x{current:x}"
        )

    confirmation = session.execute(
        f"mw.l {address_field:x} 0 1; md.l {address_field:x} 1", 10.0
    )
    if memory_value(confirmation, 32) != 0:
        raise RuntimeError("RAM-only PHY address correction did not take effect")
    return {
        "applied": True,
        "reason": "vendor_control_dt_phy_address_mismatch",
        "control_dt_phy_address": 0x10,
        "runtime_phy_address": 0,
        "address_field": f"0x{address_field:x}",
        "persistent": False,
    }


