def uboot_command(args: argparse.Namespace, sys_root: Path, dev_root: Path) -> dict[str, Any]:
    recorder = RunRecorder(f"uboot {args.uboot_action}", args.out_root)
    try:
        device = resolve_uart_device(sys_root, dev_root, args.device)
        recorder.metadata["uart"] = {"device": str(device), "baud": DEFAULT_UART_BAUD}
        outputs: dict[str, str] = {}
        with SerialConsole(device, recorder) as console:
            session = UBootSession(
                console,
                recorder,
                args.boot_timeout,
                args.target_user,
                args.target_password_file,
            )
            session.acquire_prompt(allow_reboot=not args.no_reboot)
            commands = (
                (args.uboot_command,)
                if args.uboot_action == "exec"
                else UBOOT_COLLECTION_COMMANDS
            )
            for command in commands:
                outputs[command] = session.execute(command, args.command_timeout)
        report = {
            "result": "passed",
            "stage": "uboot_command" if args.uboot_action == "exec" else "uboot_collect",
            "commands": list(outputs),
            "outputs": outputs,
            "uboot_prompt": True,
            "uboot_log": str(recorder.path / "uboot.log"),
        }
    except Exception as error:
        report = error_report("uboot_command", error)
    return recorder.finish(report)


def tftp_test_command(
    args: argparse.Namespace, sys_root: Path, dev_root: Path
) -> dict[str, Any]:
    recorder = RunRecorder("tftp-test", args.out_root)
    try:
        artifact = args.tftp_root / "test.txt"
        expected_size = artifact.stat().st_size
        expected_sha256 = hashlib.sha256(artifact.read_bytes()).hexdigest()
        device = resolve_uart_device(sys_root, dev_root, args.device)
        recorder.metadata["uart"] = {"device": str(device), "baud": DEFAULT_UART_BAUD}
        recorder.metadata["network"] = {
            "interface": LAB_INTERFACE,
            "host_ip": HOST_IP,
            "target_ip": TARGET_IP,
            "tftp_root": str(args.tftp_root),
        }
        with SerialConsole(device, recorder) as console:
            session = UBootSession(
                console,
                recorder,
                args.boot_timeout,
                args.target_user,
                args.target_password_file,
            )
            session.acquire_prompt(allow_reboot=not args.no_reboot)
            phy_workaround = apply_vendor_phy_workaround(session)
            addresses = required_load_addresses(session)
            session.execute(f"setenv ipaddr {TARGET_IP}")
            session.execute(f"setenv serverip {HOST_IP}")
            session.execute("setenv netmask 255.255.255.0")
            ping_output = session.execute(f"ping {HOST_IP}", 30.0)
            if "is alive" not in ping_output:
                raise RuntimeError("U-Boot did not report the TFTP host as alive")
            transfer_output = session.execute(
                "tftp ${kernel_addr_r} test.txt", args.command_timeout
            )
            match = re.search(r"Bytes transferred\s*=\s*(\d+)", transfer_output)
            if not match:
                raise RuntimeError("U-Boot did not report a successful TFTP byte count")
            actual_size = int(match.group(1))
            if actual_size != expected_size:
                raise RuntimeError(
                    f"TFTP size mismatch: U-Boot={actual_size}, host={expected_size}"
                )
        report = {
            "result": "passed",
            "stage": "tftp_transfer",
            "uboot_prompt": True,
            "ethernet_link": True,
            "uboot_ping": True,
            "tftp_transfer": True,
            "vendor_phy_workaround": phy_workaround,
            "load_address": addresses["kernel_addr_r"],
            "artifact": {
                "path": str(artifact),
                "size": expected_size,
                "sha256": expected_sha256,
            },
        }
    except Exception as error:
        report = error_report("tftp_transfer", error)
    return recorder.finish(report)


def vendor_manifest(vendor_root: Path) -> dict[str, Any]:
    paths = {
        "kernel": vendor_root / "Image",
        "ramdisk": vendor_root / "uInitrd",
        "fdt": vendor_root / "sun50i-h616-mangopi-mcore.dtb",
    }
    artifacts: dict[str, Any] = {}
    for role, path in paths.items():
        if not path.is_file():
            raise RuntimeError(f"missing vendor {role} artifact: {path}")
        artifacts[role] = {
            "path": str(path),
            "size": path.stat().st_size,
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        }
    return artifacts


def linux_artifact_manifest(artifact_root: Path) -> dict[str, Any]:
    manifest_path = artifact_root / "manifest.json"
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"could not read Linux artifact manifest: {manifest_path}") from error
    if not str(manifest.get("linux", {}).get("version", "")).startswith("7."):
        raise RuntimeError("artifact manifest does not describe a Linux 7.x build")

    records = manifest.get("artifacts", {})
    for name in LINUX_ARTIFACT_NAMES:
        path = artifact_root / name
        if not path.is_file():
            raise RuntimeError(f"missing Linux artifact: {path}")
        if name == "manifest.json":
            continue
        record = records.get(name)
        if not isinstance(record, dict):
            raise RuntimeError(f"manifest has no record for {name}")
        actual_size = path.stat().st_size
        actual_sha256 = hashlib.sha256(path.read_bytes()).hexdigest()
        if record.get("size") != actual_size or record.get("sha256") != actual_sha256:
            raise RuntimeError(f"artifact does not match manifest: {name}")

    image_size = (artifact_root / "Image").stat().st_size
    ramdisk_size = (artifact_root / "initramfs.cpio.gz").stat().st_size
    if image_size >= 0x0F180000:
        raise RuntimeError("Image would overlap the verified U-Boot FDT load address")
    if ramdisk_size >= 0x04000000:
        raise RuntimeError("initramfs exceeds the verified 64 MiB bring-up limit")
    return manifest


def copy_linux_artifacts(recorder: RunRecorder, artifact_root: Path) -> dict[str, Any]:
    manifest = linux_artifact_manifest(artifact_root)
    checksum_lines: list[str] = []
    for name in LINUX_ARTIFACT_NAMES:
        source = artifact_root / name
        destination = recorder.path / name
        shutil.copy2(source, destination)
        checksum_lines.append(f"{hashlib.sha256(destination.read_bytes()).hexdigest()}  {name}")
    recorder.save_text("SHA256SUMS", "\n".join(checksum_lines) + "\n")
    return manifest


def build_linux_command(args: argparse.Namespace) -> dict[str, Any]:
    recorder = RunRecorder("build-linux", args.out_root)
    try:
        command = [str(REPOSITORY_ROOT / "build" / "build.sh")]
        environment = os.environ.copy()
        environment["JOBS"] = str(args.jobs)
        process = subprocess.run(
            command,
            cwd=REPOSITORY_ROOT,
            env=environment,
            capture_output=True,
            text=True,
            check=False,
        )
        build_log = (
            "$ " + " ".join(command) + "\n" + process.stdout + process.stderr
        )
        recorder.save_text("build.log", build_log)
        if process.returncode != 0:
            raise RuntimeError(f"Linux build exited with status {process.returncode}")
        artifact_root = REPOSITORY_ROOT / "out" / "build" / "artifacts"
        manifest = copy_linux_artifacts(recorder, artifact_root)
        recorder.metadata["build"] = manifest["build"]
        recorder.metadata["linux"] = manifest["linux"]
        recorder.metadata["initramfs"] = manifest["initramfs"]
        write_json(recorder.path / "metadata.json", recorder.metadata)
        report = {
            "result": "passed",
            "stage": "build",
            "linux_version": manifest["linux"]["version"],
            "jobs": args.jobs,
            "incremental_build_directory": manifest["build"]["incremental_output"],
            "artifacts": manifest["artifacts"],
            "build_log": str(recorder.path / "build.log"),
        }
    except Exception as error:
        report = error_report("build", error)
    return recorder.finish(report)


def publish_linux_artifacts(
    recorder: RunRecorder, tftp_root: Path
) -> tuple[Path, str]:
    parent = tftp_root / "runs"
    published = parent / recorder.run_id
    temporary = parent / f".{recorder.run_id}.tmp"
    if published.exists() or temporary.exists():
        raise RuntimeError(f"TFTP run path already exists: {published}")
    parent.mkdir(parents=True, exist_ok=True)
    temporary.mkdir(mode=0o755)
    try:
        for name in ("Image", "sun50i-h616-blikvm-v4.dtb", "initramfs.cpio.gz"):
            destination = temporary / name
            # copy2 would preserve the workspace's user_home_t SELinux xattr,
            # which dnsmasq_t is correctly forbidden to read. Creating a new
            # inode here inherits the TFTP directory's tftpdir_rw_t label.
            shutil.copyfile(recorder.path / name, destination)
            destination.chmod(0o644)
        os.replace(temporary, published)
    except Exception:
        with contextlib.suppress(OSError):
            shutil.rmtree(temporary)
        raise
    return published, f"runs/{recorder.run_id}"


def parse_tftp_size(output: str, expected: int, filename: str) -> None:
    match = re.search(r"Bytes transferred\s*=\s*(\d+)", output)
    if not match:
        raise RuntimeError(f"TFTP failed for {filename}")
    actual = int(match.group(1))
    if actual != expected:
        raise RuntimeError(
            f"TFTP size mismatch for {filename}: U-Boot={actual}, host={expected}"
        )


def classify_boot_failure(text: str, stage: str) -> str:
    cleaned = clean_console(text)
    for pattern, signature in BOOT_FAILURE_PATTERNS:
        if pattern.search(cleaned):
            return signature
    if stage == "network_load":
        return "uboot_network_or_tftp_failure"
    if stage == "kernel_boot" and "Starting kernel" in cleaned:
        return "kernel_console_timeout"
    if stage == "kernel_boot" and UBOOT_PROMPT.search(cleaned):
        return "uboot_rejected_boot"
    if stage == "kernel_boot":
        return "kernel_handoff_not_observed"
    if stage == "mmc_test":
        if not re.search(r"(?:mmcblk|new high speed SD)", cleaned, re.IGNORECASE):
            return "mmc_device_not_enumerated"
        if "BLIKVM_MMC_TEST_PASS" not in cleaned:
            return "mmc_read_or_mount_failure"
    if stage.startswith("ethernet_"):
        if re.search(r"(?:EMAC|DMA).*reset timeout", cleaned, re.IGNORECASE):
            return "ethernet_mac_or_clock_reset_failure"
        if stage == "ethernet_ping":
            return "ethernet_data_path_or_ping_timeout"
        if re.search(r"(?:MDIO|PHY)", cleaned, re.IGNORECASE):
            return "ethernet_mdio_or_phy_failure"
        if "carrier" in cleaned.lower():
            return "ethernet_carrier_failure"
        if "ping" in cleaned.lower():
            return "ethernet_ip_or_ping_failure"
        return "ethernet_bringup_failure"
    return "automation_or_preflight_failure"


def capture_shell_command(
    console: SerialConsole,
    recorder: RunRecorder,
    filename: str,
    label: str,
    command: str,
    timeout: float = 30.0,
) -> tuple[int, str]:
    """Run one initramfs shell command and archive only its marked output."""

    token = f"BLIKVM_{label.upper()}"
    end_pattern = re.compile(
        rf"(?:^|\n){re.escape(token)}_END rc=([0-9]+)[ \t]*(?=\n|$)"
    )
    wrapped = (
        f"printf '\\n{token}_BEGIN\\n'; {command}; "
        f"blikvm_rc=$?; printf '\\n{token}_END rc=%s\\n' \"$blikvm_rc\""
    )
    console.write_line(wrapped.encode("utf-8"))
    try:
        _matched, raw = console.wait_for((end_pattern,), timeout)
    except ConsoleTimeoutError as error:
        lines = error.output.splitlines()
        with contextlib.suppress(ValueError):
            begin = lines.index(f"{token}_BEGIN")
            lines = lines[begin + 1 :]
        partial = "\n".join(lines).strip()
        recorder.save_text(
            filename,
            (partial + "\n" if partial else "")
            + f"collection_timeout_seconds={timeout:.1f}\n",
        )
        raise
    cleaned = clean_console(raw)
    lines = cleaned.splitlines()
    try:
        begin = lines.index(f"{token}_BEGIN")
        end = next(
            index
            for index in range(begin + 1, len(lines))
            if lines[index].startswith(f"{token}_END rc=")
        )
    except (ValueError, StopIteration) as error:
        raise RuntimeError(f"could not isolate target output for {filename}") from error
    status_match = re.fullmatch(rf"{re.escape(token)}_END rc=([0-9]+)", lines[end])
    if not status_match:
        raise RuntimeError(f"could not parse target status for {filename}")
    output = "\n".join(lines[begin + 1 : end]).strip() + "\n"
    recorder.save_text(filename, output)
    return int(status_match.group(1)), output


def parse_mmc_lsblk(text: str) -> list[dict[str, str]]:
    """Parse the tab-separated MMC inventory emitted by initramfs/lsblk."""

    lines = [line for line in text.splitlines() if line]
    if not lines:
        return []
    fields = lines[0].split("\t")
    expected = (
        "NAME",
        "KNAME",
        "MAJ:MIN",
        "RO",
        "SIZE_SECTORS",
        "TYPE",
        "FSTYPE",
        "MOUNTPOINT",
    )
    if tuple(fields) != expected:
        raise RuntimeError("unexpected initramfs lsblk header")
    devices: list[dict[str, str]] = []
    for line in lines[1:]:
        values = line.split("\t")
        if len(values) != len(fields):
            raise RuntimeError(f"malformed initramfs lsblk row: {line}")
        devices.append(dict(zip((field.lower() for field in fields), values)))
    return devices


def parse_ip_link_interfaces(text: str) -> list[str]:
    """Return physical-test candidates from `ip -o link show` output."""

    interfaces: list[str] = []
    for line in text.splitlines():
        match = re.match(r"^\d+:\s+([^:@\s]+)(?:@[^:]+)?:", line)
        if match and match.group(1) != "lo":
            interfaces.append(match.group(1))
    return interfaces


def assess_ethernet_evidence(
    interface: str | None,
    statuses: dict[str, int],
    evidence: dict[str, str],
) -> tuple[dict[str, dict[str, Any]], str | None]:
    """Turn archived target output into ordered Ethernet stage results."""

    dmesg = evidence.get("ethernet-dmesg.log", "")
    phy = evidence.get("phy-mdio.log", "")
    link = evidence.get("ip-link.log", "")
    address = evidence.get("ip-addr.log", "")
    carrier = evidence.get("carrier-state.log", "")
    ping = evidence.get("ping.log", "")
    route = evidence.get("ip-route.log", "")

    checks: dict[str, dict[str, Any]] = {
        "mac_probe": {
            "status": "pass"
            if re.search(r"dwmac-sun8i\s+5030000\.ethernet", dmesg)
            and not re.search(r"(?:probe.*failed|EMAC reset timeout)", dmesg, re.I)
            else "fail",
        },
        "mdio_bus": {
            "status": "pass"
            if statuses.get("phy-mdio.log") == 0 and "mdio_bus=" in phy
            else "fail",
        },
        "phy_detected": {
            "status": "pass"
            if "phy_address=00" in phy and "phy_id=0x00441400" in phy
            else "fail",
            "expected_address": 0,
            "expected_phy_id": "0x00441400",
        },
        "interface_present": {
            "status": "pass" if interface else "fail",
            "interface": interface,
        },
        "carrier": {
            "status": "pass"
            if statuses.get("carrier-state.log") == 0
            and "carrier=1" in carrier
            and "LOWER_UP" in link
            else "fail",
        },
        "static_address": {
            "status": "pass"
            if statuses.get("ip-addr.log") == 0
            and re.search(r"\binet\s+192\.168\.88\.2/24\b", address)
            and statuses.get("ip-route.log") == 0
            and "default_route_present=0" in route
            else "fail",
            "address": "192.168.88.2/24",
            "default_route_added": False,
            "dns_configured": False,
            "dhcp_used": False,
        },
        "ping": {
            "status": "pass"
            if statuses.get("ping.log") == 0
            and re.search(r"(?:^|\s)0% packet loss", ping)
            else "fail",
            "peer": HOST_IP,
        },
        "no_persistent_errors": {
            "status": "pass"
            if statuses.get("ethernet-dmesg.log") == 0
            and not ETHERNET_FAILURE.search(dmesg)
            else "fail",
        },
    }
    ordered = (
        "mac_probe",
        "mdio_bus",
        "phy_detected",
        "interface_present",
        "carrier",
        "static_address",
        "ping",
        "no_persistent_errors",
    )
    failed_stage = next(
        (name for name in ordered if checks[name]["status"] != "pass"), None
    )
    return checks, failed_stage


def run_mmc_test(console: SerialConsole, recorder: RunRecorder) -> dict[str, Any]:
    """Inventory and read the vendor SD root partition without allowing writes."""

    evidence: dict[str, str] = {}
    statuses: dict[str, int] = {}

    commands = (
        (
            "mmc-enumeration.log",
            "mmc_wait",
            "i=0; while [ ! -b /dev/mmcblk0p1 ] && [ \"$i\" -lt 15 ]; "
            "do sleep 1; i=$((i + 1)); done; "
            "printf 'wait_seconds=%s\\n' \"$i\"; [ -b /dev/mmcblk0p1 ]",
            25.0,
        ),
        (
            "block-readonly.log",
            "mmc_readonly",
            "ok=1; found=0; for dev in /dev/mmcblk[0-9] /dev/mmcblk[0-9]p*; "
            "do [ -b \"$dev\" ] || continue; found=1; "
            "blockdev --setro \"$dev\" || ok=0; "
            "ro=$(blockdev --getro \"$dev\" 2>/dev/null || echo error); "
            "printf '%s ro=%s\\n' \"$dev\" \"$ro\"; "
            "[ \"$ro\" = 1 ] || ok=0; done; "
            "[ \"$found\" -eq 1 ] && [ \"$ok\" -eq 1 ]",
            20.0,
        ),
        (
            "mmc-identify.log",
            "mmc_identify",
            "found=0; for card in /sys/bus/mmc/devices/mmc*:*; "
            "do [ -d \"$card\" ] || continue; found=1; "
            "printf 'sysfs_device=%s\\n' \"${card##*/}\"; "
            "for attr in type name manfid oemid serial date cid csd ocr; "
            "do [ -r \"$card/$attr\" ] && "
            "printf '%s=%s\\n' \"$attr\" \"$(cat \"$card/$attr\")\"; done; "
            "done; [ \"$found\" -eq 1 ]",
            20.0,
        ),
        ("lsblk.log", "mmc_lsblk", "lsblk", 20.0),
        ("blkid.log", "mmc_blkid", "blkid", 20.0),
        ("proc-partitions.log", "mmc_partitions", "cat /proc/partitions", 20.0),
        ("partition-table.log", "mmc_fdisk", "fdisk -l /dev/mmcblk0", 20.0),
        (
            "mmc-dmesg.log",
            "mmc_dmesg",
            "dmesg | grep -Ei 'mmc|sunxi|regulator|ext4|partition'",
            20.0,
        ),
    )
    for filename, label, command, timeout in commands:
        status, output = capture_shell_command(
            console, recorder, filename, label, command, timeout
        )
        statuses[filename] = status
        evidence[filename] = output

    mount_command = (
        "( set -e; mounted=0; "
        "cleanup() { [ \"$mounted\" -eq 0 ] || umount /mnt/mmc-test; }; "
        "trap cleanup EXIT; mkdir -p /mnt/mmc-test; "
        "mount -t ext4 -o ro,noload /dev/mmcblk0p1 /mnt/mmc-test; mounted=1; "
        "grep ' /mnt/mmc-test ext4 ro,' /proc/mounts; "
        "test -r /mnt/mmc-test/etc/os-release; "
        "echo BLIKVM_MMC_FILE_BEGIN; cat /mnt/mmc-test/etc/os-release; "
        "echo BLIKVM_MMC_FILE_END; "
        "sha256sum /mnt/mmc-test/etc/os-release; "
        "echo 'BLIKVM_MMC_TEST_PASS device=/dev/mmcblk0 "
        "partition=/dev/mmcblk0p1 filesystem=ext4 file=/etc/os-release "
        "mount_options=ro,noload' )"
    )
    mount_status, mount_output = capture_shell_command(
        console,
        recorder,
        "mount-readonly.log",
        "mmc_mount",
        mount_command,
        30.0,
    )
    statuses["mount-readonly.log"] = mount_status
    evidence["mount-readonly.log"] = mount_output

    post_status, post_output = capture_shell_command(
        console,
        recorder,
        "mmc-dmesg-after-mount.log",
        "mmc_dmesg_after",
        "dmesg | grep -Ei 'mmc|sunxi|regulator|ext4|partition'",
        20.0,
    )
    statuses["mmc-dmesg-after-mount.log"] = post_status
    evidence["mmc-dmesg-after-mount.log"] = post_output

    failures = [name for name, status in statuses.items() if status != 0]
    if failures:
        raise RuntimeError("MMC target commands failed: " + ", ".join(failures))
    if not MMC_TEST_PASS.search(mount_output):
        raise RuntimeError("read-only MMC mount did not emit the success marker")

    devices = parse_mmc_lsblk(evidence["lsblk.log"])
    by_name = {device["name"]: device for device in devices}
    disk = by_name.get("mmcblk0")
    partition = by_name.get("mmcblk0p1")
    if disk is None or partition is None:
        raise RuntimeError("lsblk did not identify mmcblk0 and mmcblk0p1")
    if partition["fstype"] != "ext4":
        raise RuntimeError(
            f"mmcblk0p1 has unexpected filesystem {partition['fstype']!r}"
        )
    if any(device["ro"] != "1" for device in devices):
        raise RuntimeError("not every detected MMC block device is forced read-only")

    return {
        "controller": "4020000.mmc",
        "card": "mmc0",
        "block_device": disk,
        "partitions": [device for device in devices if device["type"] == "part"],
        "mounted_partition": "/dev/mmcblk0p1",
        "filesystem": "ext4",
        "mount_options": ["ro", "noload"],
        "file_read": "/etc/os-release",
        "unmounted_after_test": True,
        "storage_writes_attempted": False,
        "evidence": {name: str(recorder.path / name) for name in statuses},
    }


def run_ethernet_test(
    console: SerialConsole, recorder: RunRecorder
) -> dict[str, Any]:
    """Validate EMAC1, MDIO, PHY, carrier, and a static isolated-lab ping."""

    evidence: dict[str, str] = {}
    statuses: dict[str, int] = {}

    initial_commands = (
        (
            "ethernet-dmesg-probe.log",
            "ethernet_probe_dmesg",
            "dmesg | grep -Ei '5030000|dwmac|stmmac|ethernet|mdio|phy|link'",
        ),
        ("ip-link-before.log", "ethernet_link_before", "ip -o link show"),
        ("ip-addr-before.log", "ethernet_addr_before", "ip -o addr show"),
        (
            "phy-mdio.log",
            "ethernet_phy_mdio",
            "found_bus=0; found_phy=0; "
            "for bus in /sys/class/mdio_bus/*; do [ -e \"$bus\" ] || continue; "
            "found_bus=1; printf 'mdio_bus=%s\\n' \"${bus##*/}\"; done; "
            "for phy in /sys/bus/mdio_bus/devices/*; do "
            "[ -e \"$phy\" ] || continue; found_phy=1; name=${phy##*/}; "
            "printf 'phy_device=%s\\n' \"$name\"; "
            "printf 'phy_address=%s\\n' \"${name##*:}\"; "
            "for attr in phy_id modalias uevent; do [ -r \"$phy/$attr\" ] && "
            "printf '%s=%s\\n' \"$attr\" \"$(cat \"$phy/$attr\")\"; done; "
            "[ ! -L \"$phy/driver\" ] || printf 'phy_driver=%s\\n' "
            "\"$(readlink \"$phy/driver\")\"; "
            "[ ! -L \"$phy/of_node\" ] || printf 'of_node=%s\\n' "
            "\"$(readlink \"$phy/of_node\")\"; done; "
            "[ \"$found_bus\" -eq 1 ] && [ \"$found_phy\" -eq 1 ]",
        ),
    )
    for filename, label, command in initial_commands:
        status, output = capture_shell_command(
            console, recorder, filename, label, command, 20.0
        )
        statuses[filename] = status
        evidence[filename] = output

    interfaces = parse_ip_link_interfaces(evidence["ip-link-before.log"])
    interface = interfaces[0] if len(interfaces) == 1 else None
    if interface is None:
        unavailable = (
            "interface=unavailable\n"
            f"candidate_count={len(interfaces)}\n"
            f"candidates={','.join(interfaces)}\n"
        )
        for filename in (
            "link-up.log",
            "carrier-state.log",
            "ip-addr.log",
            "ip-route.log",
            "ip-link.log",
            "ping.log",
        ):
            recorder.save_text(filename, unavailable)
            evidence[filename] = unavailable
            statuses[filename] = 1
    else:
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", interface):
            raise RuntimeError(f"unsafe target interface name: {interface!r}")

        commands = (
            (
                "link-up.log",
                "ethernet_link_up",
                f"ip link set {interface} up; link_rc=$?; "
                "ip link show; "
                "[ \"$link_rc\" -eq 0 ]",
                20.0,
            ),
            (
                "carrier-state.log",
                "ethernet_carrier",
                f"i=0; while [ \"$(cat /sys/class/net/{interface}/carrier "
                "2>/dev/null)\" != 1 ] && [ \"$i\" -lt 30 ]; "
                "do sleep 1; i=$((i + 1)); done; "
                f"printf 'interface={interface}\\nwait_seconds=%s\\n' \"$i\"; "
                f"for attr in carrier operstate speed duplex address; do "
                f"printf '%s=%s\\n' \"$attr\" "
                f"\"$(cat /sys/class/net/{interface}/$attr 2>/dev/null || "
                "echo unavailable)\"; done; "
                f"[ \"$(cat /sys/class/net/{interface}/carrier 2>/dev/null)\" = 1 ]",
                40.0,
            ),
            (
                "ip-addr.log",
                "ethernet_static_address",
                f"ip addr add {TARGET_IP}/24 dev {interface}; add_rc=$?; "
                f"ip addr show dev {interface}; "
                f"ip addr show dev {interface} | "
                f"grep -Eq 'inet {re.escape(TARGET_IP)}/24'; "
                "addr_rc=$?; [ \"$add_rc\" -eq 0 ] && [ \"$addr_rc\" -eq 0 ]",
                20.0,
            ),
            (
                "ip-route.log",
                "ethernet_route",
                "ip route list; if ip route list | grep -q '^default'; "
                "then echo default_route_present=1; false; "
                "else echo default_route_present=0; true; fi",
                20.0,
            ),
            (
                "ip-link.log",
                "ethernet_link_final",
                "ip -o link show",
                20.0,
            ),
            (
                "ping.log",
                "ethernet_ping",
                "ping_rc=0; attempt=1; while [ \"$attempt\" -le 5 ]; do "
                "printf 'ping_attempt=%s\\n' \"$attempt\"; "
                f"ping -c 1 -W 2 -I {interface} {HOST_IP} || ping_rc=1; "
                "attempt=$((attempt + 1)); done; [ \"$ping_rc\" -eq 0 ]",
                30.0,
            ),
        )
        collection_timeout: dict[str, Any] | None = None
        for index, (filename, label, command, timeout) in enumerate(commands):
            try:
                status, output = capture_shell_command(
                    console, recorder, filename, label, command, timeout
                )
            except ConsoleTimeoutError as error:
                statuses[filename] = 124
                evidence[filename] = read_text(recorder.path / filename)
                collection_timeout = {
                    "evidence": filename,
                    "timeout_seconds": timeout,
                    "message": str(error),
                }
                for skipped_filename, _label, _command, _timeout in commands[
                    index + 1 :
                ]:
                    skipped = f"skipped_after_timeout={filename}\n"
                    recorder.save_text(skipped_filename, skipped)
                    statuses[skipped_filename] = 125
                    evidence[skipped_filename] = skipped
                break
            statuses[filename] = status
            evidence[filename] = output

    if interface is not None and collection_timeout is not None:
        dmesg_output = (
            evidence["ethernet-dmesg-probe.log"]
            + f"final_collection_skipped_after_timeout={collection_timeout['evidence']}\n"
        )
        recorder.save_text("ethernet-dmesg.log", dmesg_output)
        statuses["ethernet-dmesg.log"] = 125
        evidence["ethernet-dmesg.log"] = dmesg_output
    else:
        dmesg_status, dmesg_output = capture_shell_command(
            console,
            recorder,
            "ethernet-dmesg.log",
            "ethernet_dmesg_final",
            "dmesg | grep -Ei '5030000|dwmac|stmmac|ethernet|mdio|phy|link|timeout|watchdog'",
            20.0,
        )
        statuses["ethernet-dmesg.log"] = dmesg_status
        evidence["ethernet-dmesg.log"] = dmesg_output

    checks, failed_stage = assess_ethernet_evidence(interface, statuses, evidence)
    speed_match = re.search(r"(?m)^speed=([^\n]+)$", evidence["carrier-state.log"])
    duplex_match = re.search(r"(?m)^duplex=([^\n]+)$", evidence["carrier-state.log"])
    mac_match = re.search(r"(?m)^address=([^\n]+)$", evidence["carrier-state.log"])
    phy_device_match = re.search(
        r"(?m)^phy_device=([^\n]+)$", evidence["phy-mdio.log"]
    )
    phy_device = phy_device_match.group(1) if phy_device_match else None

    return {
        "result": "passed" if failed_stage is None else "failed",
        "failed_stage": failed_stage,
        "collection_timeout": collection_timeout if interface is not None else None,
        "controller": "5030000.ethernet",
        "interface": interface,
        "phy": {
            "mdio_bus": phy_device.rsplit(":", 1)[0] if phy_device else None,
            "device": phy_device,
            "address": 0 if checks["phy_detected"]["status"] == "pass" else None,
            "id": "0x00441400"
            if checks["phy_detected"]["status"] == "pass"
            else None,
            "binding": "ethernet-phy-ieee802.3-c22",
        },
        "link": {
            "carrier": checks["carrier"]["status"] == "pass",
            "speed_mbps": speed_match.group(1) if speed_match else None,
            "duplex": duplex_match.group(1) if duplex_match else None,
            "mac_address": mac_match.group(1) if mac_match else None,
        },
        "ip": {
            "address": f"{TARGET_IP}/24",
            "peer": HOST_IP,
            "dhcp_used": False,
            "dns_configured": False,
            "default_gateway_configured": False,
        },
        "ping": {
            "requested_probes": 5,
            "successful_probes": len(
                re.findall(
                    r"(?m)^1 packets transmitted, 1 packets received, "
                    r"0% packet loss$",
                    evidence["ping.log"],
                )
            ),
        },
        "checks": checks,
        "evidence": {
            name: str(recorder.path / name)
            for name in (
                "ethernet-dmesg-probe.log",
                "phy-mdio.log",
                "link-up.log",
                "carrier-state.log",
                "ip-link-before.log",
                "ip-link.log",
                "ip-addr-before.log",
                "ip-addr.log",
                "ip-route.log",
                "ping.log",
                "ethernet-dmesg.log",
            )
        },
    }


def boot_linux_command(
    args: argparse.Namespace, sys_root: Path, dev_root: Path
) -> dict[str, Any]:
    run_mmc = args.command in ("boot-mmc", "boot-ethernet")
    run_ethernet = args.command == "boot-ethernet"
    recorder = RunRecorder(args.command, args.out_root)
    stage = "preflight"
    last_passed = "none"
    manifest: dict[str, Any] | None = None
    publication: Path | None = None
    mmc: dict[str, Any] | None = None
    ethernet: dict[str, Any] | None = None
    try:
        manifest = copy_linux_artifacts(recorder, args.artifact_root)
        recorder.metadata["artifacts"] = manifest["artifacts"]
        recorder.metadata["linux"] = manifest["linux"]
        recorder.metadata["initramfs"] = manifest["initramfs"]
        recorder.metadata["safety"].update(
            {
                "target_storage_writes_attempted": False,
                "target_filesystem_mount_mode": "read-only" if run_mmc else None,
                "dhcp_used": False,
                "dns_configured": False,
                "default_gateway_configured": False,
            }
        )
        device = resolve_uart_device(sys_root, dev_root, args.device)
        recorder.metadata["uart"] = {
            "device": str(device),
            "baud": DEFAULT_UART_BAUD,
            "format": "8N1",
            "flow_control": "none",
        }
        publication, tftp_prefix = publish_linux_artifacts(recorder, args.tftp_root)
        recorder.metadata["network"] = {
            "interface": LAB_INTERFACE,
            "host_ip": HOST_IP,
            "target_ip": TARGET_IP,
            "tftp_root": str(args.tftp_root),
            "published_path": str(publication),
        }
        write_json(recorder.path / "metadata.json", recorder.metadata)
        last_passed = "deploy"

        sizes = {
            name: (recorder.path / name).stat().st_size
            for name in ("Image", "sun50i-h616-blikvm-v4.dtb", "initramfs.cpio.gz")
        }
        with SerialConsole(device, recorder) as console:
            session = UBootSession(
                console,
                recorder,
                args.boot_timeout,
                args.target_user,
                args.target_password_file,
            )
            session.acquire_prompt(allow_reboot=not args.no_reboot)
            last_passed = "uboot_interrupt"
            phy_workaround = apply_vendor_phy_workaround(session)
            addresses = required_load_addresses(session)

            stage = "network_load"
            session.execute(f"setenv ipaddr {TARGET_IP}")
            session.execute(f"setenv serverip {HOST_IP}")
            session.execute("setenv netmask 255.255.255.0")
            ping_output = session.execute(f"ping {HOST_IP}", 30.0)
            if "is alive" not in ping_output:
                raise RuntimeError("U-Boot ping failed before Linux boot")

            transfer = session.execute(
                f"tftp ${{kernel_addr_r}} {tftp_prefix}/Image", args.command_timeout
            )
            parse_tftp_size(transfer, sizes["Image"], "Image")
            transfer = session.execute(
                f"tftp ${{ramdisk_addr_r}} {tftp_prefix}/initramfs.cpio.gz",
                args.command_timeout,
            )
            parse_tftp_size(transfer, sizes["initramfs.cpio.gz"], "initramfs.cpio.gz")
            session.execute("setenv ramdisk_size ${filesize}")
            transfer = session.execute(
                f"tftp ${{fdt_addr_r}} {tftp_prefix}/sun50i-h616-blikvm-v4.dtb",
                args.command_timeout,
            )
            parse_tftp_size(
                transfer,
                sizes["sun50i-h616-blikvm-v4.dtb"],
                "sun50i-h616-blikvm-v4.dtb",
            )
            session.execute(
                'setenv bootargs "console=ttyS0,115200n8 earlycon '
                'loglevel=8 ignore_loglevel printk.time=1 rdinit=/init panic=-1"'
            )
            last_passed = "network_load"

            stage = "kernel_boot"
            console.write_line(
                b"booti ${kernel_addr_r} ${ramdisk_addr_r}:${ramdisk_size} "
                b"${fdt_addr_r}"
            )
            boot_patterns = (
                INITRAMFS_READY,
                *(pattern for pattern, _signature in BOOT_FAILURE_PATTERNS),
                UBOOT_PROMPT,
            )
            matched, boot_text = console.wait_for(boot_patterns, args.linux_timeout)
            if matched != 0:
                raise RuntimeError("boot stopped before the initramfs ready marker")
            last_passed = "initramfs"
            stage = "serial_shell"

            # MMC enumeration can interleave printk output through the first
            # BusyBox prompt and tear its literal byte sequence. Elicit a new
            # prompt after the boot log settles instead of relying on that
            # asynchronous first rendering.
            console.write_line(b"")
            _, prompt_text = console.wait_for((INITRAMFS_SHELL,), 15.0)
            boot_text += prompt_text
            console.write_line(
                b"printf 'BLIKVM_SHELL_OK kernel=%s\\n' \"$(uname -r)\""
            )
            _, verification = console.wait_for((SHELL_VERIFIED,), 10.0)
            boot_text += verification
            last_passed = "serial_shell"

            if run_mmc:
                stage = "mmc_test"
                mmc = run_mmc_test(console, recorder)
                last_passed = "mmc_read_only"

            if run_ethernet:
                stage = "ethernet_test"
                ethernet = run_ethernet_test(console, recorder)
                if ethernet["result"] != "passed":
                    failed_stage = ethernet["failed_stage"] or "unknown"
                    stage = f"ethernet_{failed_stage}"
                    raise RuntimeError(
                        f"Ethernet validation failed at stage {failed_stage}"
                    )
                last_passed = "ethernet_ping"

            console.write_line(
                b"echo BLIKVM_DMESG_BEGIN; dmesg; echo BLIKVM_DMESG_END"
            )
            _, dmesg_text = console.wait_for((DMESG_END,), 20.0)
            recorder.save_text("dmesg.log", dmesg_text)
            recorder.save_text("boot-console.log", boot_text)

        report: dict[str, Any] = {
            "result": "passed",
            "stage": (
                "ethernet_ping"
                if run_ethernet
                else "mmc_read_only"
                if run_mmc
                else "serial_shell"
            ),
            "last_passed_stage": last_passed,
            "linux_version": manifest["linux"]["version"],
            "uart_available": True,
            "uboot_prompt": True,
            "uboot_ping": True,
            "tftp_transfer": True,
            "kernel_started": True,
            "init_reached": True,
            "serial_shell_usable": True,
            "ready_marker": manifest["initramfs"]["ready_marker"],
            "vendor_phy_workaround": phy_workaround,
            "load_addresses": addresses,
            "tftp_publication": str(publication),
            "uart_log": str(recorder.path / "uart.log"),
            "dmesg_log": str(recorder.path / "dmesg.log"),
        }
        if mmc is not None:
            report["mmc"] = mmc
        if ethernet is not None:
            report["ethernet"] = ethernet
    except Exception as error:
        raw_path = recorder.path / "uart.raw"
        evidence = raw_path.read_bytes() if raw_path.exists() else b""
        failure_signature = classify_boot_failure(
            clean_console(evidence) + "\n" + str(error), stage
        )
        report = error_report(stage, error)
        report["last_passed_stage"] = last_passed
        report["failure_signature"] = failure_signature
        report["uart_log"] = str(recorder.path / "uart.log")
        if publication is not None:
            report["tftp_publication"] = str(publication)
        if manifest is not None:
            report["linux_version"] = manifest["linux"]["version"]
        if mmc is not None:
            report["mmc"] = mmc
        if ethernet is not None:
            report["ethernet"] = ethernet
    return recorder.finish(report)


def boot_vendor_command(
    args: argparse.Namespace, sys_root: Path, dev_root: Path
) -> dict[str, Any]:
    recorder = RunRecorder("boot-vendor", args.out_root)
    try:
        artifacts = vendor_manifest(args.vendor_root)
        device = resolve_uart_device(sys_root, dev_root, args.device)
        recorder.metadata["uart"] = {"device": str(device), "baud": DEFAULT_UART_BAUD}
        recorder.metadata["artifacts"] = artifacts
        with SerialConsole(device, recorder) as console:
            session = UBootSession(
                console,
                recorder,
                args.boot_timeout,
                args.target_user,
                args.target_password_file,
            )
            session.acquire_prompt(allow_reboot=not args.no_reboot)
            phy_workaround = apply_vendor_phy_workaround(session)
            addresses = required_load_addresses(session)
            commands = (
                f"setenv ipaddr {TARGET_IP}",
                f"setenv serverip {HOST_IP}",
                "setenv netmask 255.255.255.0",
                f"ping {HOST_IP}",
                "tftp ${kernel_addr_r} vendor/Image",
                "tftp ${ramdisk_addr_r} vendor/uInitrd",
                "tftp ${fdt_addr_r} vendor/sun50i-h616-mangopi-mcore.dtb",
                'setenv bootargs "root=UUID=a990fd36-0857-4856-b0b8-5c84a7df516f '
                'rootwait rootfstype=ext4 console=ttyS0,115200 consoleblank=0 '
                'loglevel=1 ubootpart=6a80d8d9-01 '
                'usb-storage.quirks=0x2537:0x1066:u,0x2537:0x1068:u '
                'cgroup_enable=memory swapaccount=1"',
            )
            expected_tftp_sizes = {
                "vendor/Image": artifacts["kernel"]["size"],
                "vendor/uInitrd": artifacts["ramdisk"]["size"],
                "vendor/sun50i-h616-mangopi-mcore.dtb": artifacts["fdt"]["size"],
            }
            for command in commands:
                timeout = 60.0 if command.startswith("tftp ") else 30.0
                output = session.execute(command, timeout)
                if command.startswith("ping ") and "is alive" not in output:
                    raise RuntimeError("U-Boot ping failed before vendor boot")
                if command.startswith("tftp "):
                    match = re.search(r"Bytes transferred\s*=\s*(\d+)", output)
                    if not match:
                        raise RuntimeError(f"TFTP failed: {command}")
                    filename = command.rsplit(" ", 1)[-1]
                    actual_size = int(match.group(1))
                    if actual_size != expected_tftp_sizes[filename]:
                        raise RuntimeError(
                            f"TFTP size mismatch for {filename}: "
                            f"U-Boot={actual_size}, host={expected_tftp_sizes[filename]}"
                        )
            session.console.write_line(
                b"booti ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}"
            )
            _, boot_text = console.wait_for(
                (re.compile(r"(?:^|\n)mangopimcore login:\s*$", re.IGNORECASE),),
                args.linux_timeout,
            )
            recorder.log_uboot("vendor Linux boot", boot_text)
        report = {
            "result": "passed",
            "stage": "vendor_tftp_boot",
            "uart_available": True,
            "uboot_prompt": True,
            "ethernet_link": True,
            "uboot_ping": True,
            "tftp_transfer": True,
            "vendor_kernel_booted": True,
            "vendor_phy_workaround": phy_workaround,
            "load_addresses": addresses,
            "artifacts": artifacts,
        }
    except Exception as error:
        report = error_report("vendor_tftp_boot", error)
    return recorder.finish(report)


def collect_command(args: argparse.Namespace) -> dict[str, Any]:
    recorder = RunRecorder("collect", args.out_root)
    try:
        command_groups = {
            "ethernet.txt": (
                ["ip", "-br", "link"],
                ["ethtool", LAB_INTERFACE],
            ),
            "addresses.txt": (["ip", "-br", "addr"],),
            "routes.txt": (["ip", "route"],),
            "rules.txt": (["ip", "rule"],),
            "networkmanager.txt": (
                ["nmcli", "device", "status"],
                ["nmcli", "connection", "show", "--active"],
                ["nmcli", "connection", "show", "blikvm-lab"],
            ),
            "vpn.txt": (["wg", "show"],),
            "firewall.txt": (
                ["firewall-cmd", "--get-active-zones"],
                ["firewall-cmd", "--zone=blikvm-lab", "--list-all"],
            ),
            "tftp-service.txt": (
                ["systemctl", "--no-pager", "--full", "status", "dnsmasq-blikvm-tftp.service"],
            ),
        }
        statuses: dict[str, int] = {}
        for filename, commands in command_groups.items():
            sections: list[str] = []
            returncodes: list[int] = []
            for command in commands:
                process = subprocess.run(
                    command, capture_output=True, text=True, check=False
                )
                sections.append(
                    "$ " + " ".join(command) + "\n" + process.stdout + process.stderr
                )
                returncodes.append(process.returncode)
            recorder.save_text(filename, "\n".join(sections))
            statuses[filename] = max(returncodes)
        report = {
            "result": "passed" if all(code == 0 for code in statuses.values()) else "failed",
            "stage": "collect",
            "files": list(command_groups),
            "returncodes": statuses,
        }
    except Exception as error:
        report = error_report("collect", error)
    return recorder.finish(report)


def error_report(stage: str, error: Exception) -> dict[str, Any]:
    return {
        "result": "failed",
        "stage": stage,
        "error": {"type": type(error).__name__, "message": str(error)},
    }


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="labctl",
        description="BliKVM v4 UART, U-Boot, TFTP, and Linux HIL automation",
    )
    parser.add_argument("--pretty", action="store_true", help="indent JSON output")
    parser.add_argument(
        "--out-root",
        type=Path,
        default=Path(os.environ.get("LABCTL_OUT_ROOT", DEFAULT_OUT_ROOT)),
        help="per-run result directory root",
    )
    parser.add_argument(
        "--device",
        default=os.environ.get("LABCTL_UART_DEVICE"),
        help="explicit UART path (normally resolved from USB identity)",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("detect", help="discover lab devices and prerequisites")

    uart_parser = subparsers.add_parser("uart", help="capture UART output")
    uart_parser.add_argument("--seconds", type=float, default=10.0)

    uboot_parser = subparsers.add_parser("uboot", help="control U-Boot over UART")
    add_uboot_options(uboot_parser)
    uboot_actions = uboot_parser.add_subparsers(dest="uboot_action", required=True)
    exec_parser = uboot_actions.add_parser("exec", help="execute one safe command")
    exec_parser.add_argument("uboot_command")
    uboot_actions.add_parser("collect", help="collect the non-destructive environment")

    tftp_parser = subparsers.add_parser(
        "tftp-test", help="ping the host and fetch the small TFTP test artifact"
    )
    add_uboot_options(tftp_parser)
    tftp_parser.add_argument(
        "--tftp-root",
        type=Path,
        default=Path(os.environ.get("LABCTL_TFTP_ROOT", DEFAULT_TFTP_ROOT)),
    )

    vendor_parser = subparsers.add_parser(
        "boot-vendor", help="TFTP-boot preserved known-good vendor artifacts"
    )
    add_uboot_options(vendor_parser)
    vendor_parser.add_argument(
        "--vendor-root",
        type=Path,
        default=Path(
            os.environ.get("LABCTL_VENDOR_ROOT", DEFAULT_TFTP_ROOT / "vendor")
        ),
    )
    vendor_parser.add_argument("--linux-timeout", type=float, default=180.0)

    build_parser = subparsers.add_parser(
        "build-linux", help="incrementally build the Linux 7.x bring-up artifacts"
    )
    build_parser.add_argument(
        "--jobs",
        type=int,
        default=int(os.environ.get("LABCTL_JOBS", "3")),
        help="parallel build jobs (default: 3)",
    )

    linux_parser = subparsers.add_parser(
        "boot-linux", help="publish and TFTP-boot the Linux 7.x serial slice"
    )
    add_uboot_options(linux_parser)
    linux_parser.add_argument(
        "--artifact-root",
        type=Path,
        default=Path(
            os.environ.get(
                "LABCTL_LINUX_ARTIFACT_ROOT",
                REPOSITORY_ROOT / "out" / "build" / "artifacts",
            )
        ),
    )
    linux_parser.add_argument(
        "--tftp-root",
        type=Path,
        default=Path(os.environ.get("LABCTL_TFTP_ROOT", DEFAULT_TFTP_ROOT)),
    )
    linux_parser.add_argument("--linux-timeout", type=float, default=180.0)

    mmc_parser = subparsers.add_parser(
        "boot-mmc",
        help="TFTP-boot Linux and verify the existing SD filesystems read-only",
    )
    add_uboot_options(mmc_parser)
    mmc_parser.add_argument(
        "--artifact-root",
        type=Path,
        default=Path(
            os.environ.get(
                "LABCTL_LINUX_ARTIFACT_ROOT",
                REPOSITORY_ROOT / "out" / "build" / "artifacts",
            )
        ),
    )
    mmc_parser.add_argument(
        "--tftp-root",
        type=Path,
        default=Path(os.environ.get("LABCTL_TFTP_ROOT", DEFAULT_TFTP_ROOT)),
    )
    mmc_parser.add_argument("--linux-timeout", type=float, default=180.0)

    ethernet_parser = subparsers.add_parser(
        "boot-ethernet",
        help=(
            "TFTP-boot Linux, retain the read-only MMC test, and validate "
            "EMAC1 with a static isolated-lab ping"
        ),
    )
    add_uboot_options(ethernet_parser)
    ethernet_parser.add_argument(
        "--artifact-root",
        type=Path,
        default=Path(
            os.environ.get(
                "LABCTL_LINUX_ARTIFACT_ROOT",
                REPOSITORY_ROOT / "out" / "build" / "artifacts",
            )
        ),
    )
    ethernet_parser.add_argument(
        "--tftp-root",
        type=Path,
        default=Path(os.environ.get("LABCTL_TFTP_ROOT", DEFAULT_TFTP_ROOT)),
    )
    ethernet_parser.add_argument("--linux-timeout", type=float, default=180.0)

    subparsers.add_parser("collect", help="collect current host network evidence")
    args = parser.parse_args(argv)
    if getattr(args, "jobs", 1) < 1:
        parser.error("--jobs must be greater than zero")
    return args


def add_uboot_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--boot-timeout", type=float, default=90.0)
    parser.add_argument("--command-timeout", type=float, default=30.0)
    parser.add_argument(
        "--no-reboot",
        action="store_true",
        help="require the target to already be stopped at U-Boot",
    )
    parser.add_argument(
        "--target-user",
        default=os.environ.get("LABCTL_TARGET_USER", "blikvm"),
        help="vendor Linux console user used only when rebooting from login",
    )
    credential_path = os.environ.get("LABCTL_TARGET_PASSWORD_FILE")
    parser.add_argument(
        "--target-password-file",
        type=Path,
        default=Path(credential_path) if credential_path else None,
        help="runtime-only credential file; password bytes are redacted from logs",
    )


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    sys_root = Path(os.environ.get("LABCTL_SYS_ROOT", "/sys"))
    dev_root = Path(os.environ.get("LABCTL_DEV_ROOT", "/dev"))

    try:
        if args.command == "detect":
            report = detect(sys_root, dev_root)
        elif args.command == "uart":
            report = uart_command(args, sys_root, dev_root)
        elif args.command == "uboot":
            report = uboot_command(args, sys_root, dev_root)
        elif args.command == "tftp-test":
            report = tftp_test_command(args, sys_root, dev_root)
        elif args.command == "boot-vendor":
            report = boot_vendor_command(args, sys_root, dev_root)
        elif args.command == "build-linux":
            report = build_linux_command(args)
        elif args.command in ("boot-linux", "boot-mmc", "boot-ethernet"):
            report = boot_linux_command(args, sys_root, dev_root)
        elif args.command == "collect":
            report = collect_command(args)
        else:  # argparse prevents this; keep JSON error behavior explicit.
            raise ValueError(f"unsupported command: {args.command}")
    except Exception as error:  # Keep automation output machine-readable.
        report = {
            "schema_version": SCHEMA_VERSION,
            "command": args.command,
            "result": "error",
            "error": {"type": type(error).__name__, "message": str(error)},
        }
        json.dump(report, sys.stdout, sort_keys=True)
        sys.stdout.write("\n")
        return 1

    json.dump(report, sys.stdout, indent=2 if args.pretty else None, sort_keys=True)
    sys.stdout.write("\n")
    return 0 if report.get("result") in ("ok", "passed") else 1


if __name__ == "__main__":
    raise SystemExit(main())
