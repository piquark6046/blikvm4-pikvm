#!/bin/busybox sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
exec </dev/ttyS0 >/dev/ttyS0 2>&1

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
hostname blikvm-initramfs

# Built-in MMC and USB/UVC probes run concurrently with PID 1 startup. Let
# their printk traffic settle before emitting the machine-readable marker so
# the serial console cannot splice a kernel line through it.
sleep 2
echo
echo "BLIKVM_INITRAMFS_READY kernel=$(uname -r)"
echo "Minimal Alpine/BusyBox serial shell with MMC, Ethernet, USB host, and UVC diagnostics."
echo "Ethernet is left unconfigured; USB audio, gadget, display, and codec functions remain disabled."
echo

export PS1='blikvm-initramfs:/ # '
# PID 1 already owns explicit ttyS0 file descriptors above. Alpine's BusyBox
# does not enable the optional cttyhack applet, so execute its shell directly.
exec /bin/busybox sh -i
