# Rescue fallback used only if the kernel cannot execute /init. Keep the
# serial shell usable so a failed bring-up can still be diagnosed/rebooted.
::sysinit:/bin/mount -t devtmpfs devtmpfs /dev
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
ttyS0::respawn:/bin/sh -i
::ctrlaltdel:/sbin/reboot -f
