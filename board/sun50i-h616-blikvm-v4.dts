// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Minimal first-boot device tree for the BliKVM v4.
 *
 * This intentionally describes only DRAM, the proven UART0 console, the
 * removable SD slot on MMC0, the EMAC1 RMII Ethernet path, and the single
 * USB1 host path wired to the internal HDMI capture device. Display/media,
 * USB gadget, GPIO/ATX functions, and other carrier peripherals belong to
 * later, independently validated slices.
 */

/dts-v1/;

#include "sun50i-h616.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "BliKVM v4 (serial + MMC + Ethernet + USB host bring-up)";
	compatible = "blicube,blikvm-v4", "allwinner,sun50i-h616";

	aliases {
		ethernet0 = &emac1;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};

	/*
	 * The vendor DT routes MMC0 and the PF I/O bank to the PMIC's always-on
	 * 3.3 V LDO2 ("vcc-sys"). U-Boot has already established this rail.
	 * Model it as non-switchable here so this read-only slice does not need
	 * to control the AXP1530-compatible PMIC.
	 */
	reg_vcc_sys: regulator-vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc-sys";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * The captured vendor DT identifies PC8 as the active-high enable for
	 * the capture device's dedicated 5 V USB1 VBUS switch. Unlike vcc-sys,
	 * this rail is enabled only while the USB1 PHY is in use.
	 */
	reg_usb1_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&pio 2 8 GPIO_ACTIVE_HIGH>; /* PC8 */
	};
};

/* USB1 is the only host wired to the internal high-speed MS2131. */
&ehci1 {
	status = "okay";
};

&emac1 {
	pinctrl-names = "default";
	pinctrl-0 = <&emac1_rmii_pins>;
	phy-mode = "rmii";
	phy-handle = <&ext_rmii_phy>;
	phy-supply = <&reg_vcc_sys>;
	status = "okay";
};

&mdio1 {
	ext_rmii_phy: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mmc0 {
	bus-width = <4>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
	disable-wp;
	vmmc-supply = <&reg_vcc_sys>;
	status = "okay";
};

&pio {
	vcc-pa-supply = <&reg_vcc_sys>;
	vcc-pf-supply = <&reg_vcc_sys>;

	emac1_rmii_pins: emac1-rmii-pins {
		pins = "PA0", "PA1", "PA2", "PA3", "PA4",
		       "PA5", "PA6", "PA7", "PA8", "PA9";
		function = "emac1";
		drive-strength = <40>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_ph_pins>;
	status = "okay";
};

&usbphy {
	usb1_vbus-supply = <&reg_usb1_vbus>;
	status = "okay";
};
